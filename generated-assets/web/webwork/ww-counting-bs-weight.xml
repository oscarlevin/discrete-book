    <statement><p>How many 9-bit strings of weight 7 start with <m>101</m> or end with <m>10</m> or both?</p>
<p><fillin characters="10" name="AnSwEr0001"/></p>
</statement>
    <answer>
      <p>
        <m>\mathop{\rm C}\nolimits\mathopen{}\left(6,5\right)+\mathop{\rm C}\nolimits\mathopen{}\left(7,6\right)-\mathop{\rm C}\nolimits\mathopen{}\left(4,4\right)</m>
      </p>
    </answer>
    <solution><p><m>{6 \choose 5} + {7 \choose 6} - {4 \choose 4}</m> strings.</p>
</solution>
