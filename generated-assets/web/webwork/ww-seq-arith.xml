  <static seed="218" source="Contrib/DMOI/2-Sequences/2_6-Chapter_Summary/2_6_2.pg">
    <statement><p>Consider the sequence <m>13, 17, 21, 25, \ldots, 4n + 1\text{.}</m></p>
<p><ol label="a.">
<li>
<p>How many terms are there in the sequence?</p>
<p><fillin characters="10" name="AnSwEr0001"/></p>
</li>
<li>
<p>What is the second-to-last term?</p>
<p><fillin characters="10" name="AnSwEr0002"/></p>
</li>
<li>
<p>Find the sum of all the terms in the sequence.</p>
<p><fillin characters="10" name="AnSwEr0003"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>n-3</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>4n+\left(-3\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\frac{\left(4n+14\right)\mathopen{}\left(n-3\right)}{2}</m>
      </p>
    </answer>
    <solution><p><ol label="a.">
<li>
<p><m>{n-3}</m> terms.</p>
</li>
<li>
<p><m>{4n+\left(-3\right)}\text{.}</m></p>
</li>
<li>
<p><m>\frac{(4n+14)*({n-3})}{2}\text{.}</m></p>
</li>
</ol></p>
</solution>
