  <static seed="170" source="Contrib/DMOI/1-Counting/1_7-Chapter_Summary/1_7_10.pg">
    <statement><p>For each of the following, find the number of shortest lattice paths from <m>(5,5)</m> to <m>(10,10)</m> which: 
<ol label="a.">
<li>
<p>pass through the point <m>(7,6)\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0001"/></p>
</li>
<li>
<p>avoid (do not pass through) the point <m>(9,9)\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0002"/></p>
</li>
<li>
<p>either pass through <m>(7,6)</m> or <m>(9,9)</m> (or both).</p>
<p><fillin characters="15" name="AnSwEr0003"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>\mathop{\rm C}\nolimits\mathopen{}\left(3,2\right)\mathop{\rm C}\nolimits\mathopen{}\left(7,3\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\mathop{\rm C}\nolimits\mathopen{}\left(10,5\right)-\mathop{\rm C}\nolimits\mathopen{}\left(8,4\right)\mathop{\rm C}\nolimits\mathopen{}\left(2,1\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>105+\mathop{\rm C}\nolimits\mathopen{}\left(8,4\right)\mathop{\rm C}\nolimits\mathopen{}\left(2,1\right)-60</m>
      </p>
    </answer>
    <solution><p><ol label="a.">
<li>
<p><m>{3 \choose 2}{7 \choose 3}={105}</m> paths.</p>
</li>
<li>
<p><m>{10 \choose 5} - {8 \choose 4}{2 \choose 1}={112}</m> paths.</p>
</li>
<li>
<p><m>{3 \choose 2}{7 \choose 3} + {8 \choose 4}{2 \choose 1} - {3 \choose 2}{5 \choose 2}{2 \choose 1}= {185}</m> paths.</p>
</li>
</ol></p>
</solution>
