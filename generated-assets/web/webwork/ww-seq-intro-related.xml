  <static seed="183" source="Contrib/DMOI/2-Sequences/2_1-Describing_Sequences/2_1_1.pg">
    <statement><p>Find the closed formula for each of the following sequences <m>(a_n)_{n\ge 1}</m> by relating them to a well known sequence. 
Assume the first term given is <m>a_1\text{.}</m>
<ol label="a.">
<li>
<p><m>2, 4, 7, 11, 16, \ldots</m></p>
<p><m>a_n =</m> <fillin characters="10" name="AnSwEr0001"/></p>
</li>
<li>
<p><m>0, 3, 8, 15, 24, \ldots</m></p>
<p><m>a_n =</m> <fillin characters="10" name="AnSwEr0002"/></p>
</li>
<li>
<p><m>-1, 0, 3, 8, 15, \ldots</m></p>
<p><m>a_n =</m> <fillin characters="10" name="AnSwEr0003"/></p>
</li>
<li>
<p><m>0, 4, 22, 118, 718, \ldots</m></p>
<p><m>a_n =</m> <fillin characters="10" name="AnSwEr0004"/></p>
</li>
</ol></p>
</statement>
    <hint><p>Try adding or subtracting the same small number from each term to see if you recognize the sequence.</p>
</hint>
    <answer>
      <p>
        <m>\frac{n\mathopen{}\left(n+1\right)}{2}+1</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>n^{2}+\left(-1\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left(n+\left(-1\right)\right)^{2}+\left(-1\right)</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left(n+1\right)!-2</m>
      </p>
    </answer>
  </static>
