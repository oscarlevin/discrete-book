    <statement><p>Let <m>A = {\left\{5,6,7,8,9\right\}}\text{,}</m> <m>B = {\left\{7,8,9,10,11\right\}}\text{,}</m> and <m>C = {\left\{6,9,11\right\}}\text{.}</m></p>
<p><ol label="a.">
<li>
<p>Find <m>A \cap B\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0001"/></p>
</li>
<li>
<p>Find <m>A \cup B\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0002"/></p>
</li>
<li>
<p>Find <m>A \setminus B\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0003"/></p>
</li>
<li>
<p>Find <m>A \cap \overline{(B \cup C)}\text{.}</m></p>
<p><fillin characters="10" name="AnSwEr0004"/></p>
</li>
</ol></p>
</statement>
    <answer>
      <p>
        <m>\left\{7,8,9\right\}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left\{5,6,7,8,9,10,11\right\}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left\{5,6\right\}</m>
      </p>
    </answer>
    <answer>
      <p>
        <m>\left\{5\right\}</m>
      </p>
    </answer>
    <solution><p><ol label="a.">
<li>
<p><m>A \cap B = {\left\{7,8,9\right\}}\text{.}</m></p>
</li>
<li>
<p><m>A \cup B = {\left\{5,6,7,8,9,10,11\right\}}\text{.}</m></p>
</li>
<li>
<p><m>A \setminus B ={\left\{5,6\right\}}\text{.}</m></p>
</li>
<li>
<p><m>A \cap \overline{(B \cup C)} = {\left\{5\right\}}\text{.}</m></p>
</li>
</ol></p>
</solution>
